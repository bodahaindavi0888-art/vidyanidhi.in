  <script>
    let isAdminLoggedIn = false;

    async function hashPassword(plainText) {
      const msgBuffer = new TextEncoder().encode(plainText);
      const hashBuffer = await crypto.subtle.digest('SHA-256', msgBuffer);
      const hashArray = Array.from(new Uint8Array(hashBuffer));
      return hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
    }

    const DEFAULT_HASH = "240be518fabd2724ddb6f04eeb1da5967448d7e831c08c8fa822809f74c720a9";
    const RECOVERY_PIN = "9908";

    function getSavedHash() {
      return localStorage.getItem('vidyarthinidhi_admin_hash') || DEFAULT_HASH;
    }

    async function verifyAdmin() {
      const pass = document.getElementById('adminPass').value;
      if (!pass) { alert("పాస్‌వర్డ్ నమోదు చేయండి!"); return; }
      
      const hashedInput = await hashPassword(pass);
      if (hashedInput === getSavedHash()) {
        isAdminLoggedIn = true;
        document.getElementById('loginForm').style.display = 'none';
        document.getElementById('forgotForm').style.display = 'none';
        document.getElementById('uploadForm').style.display = 'block';
        document.getElementById('adminPass').value = '';
        toggleAdminControls(true);
      } else {
        alert("తప్పుడు పాస్‌వర్డ్!");
      }
    }

    function togglePasswordChangeBox() {
      const box = document.getElementById('changePasswordBox');
      box.style.display = (box.style.display === 'none') ? 'block' : 'none';
    }

    async function changeAdminPassword() {
      const current = document.getElementById('currentPassInput').value;
      const newPass = document.getElementById('newPassInput').value;

      if (!current || !newPass) { alert("అన్ని ఫీల్డులను నమోదు చేయండి!"); return; }
      if (newPass.length < 5) { alert("కనీసం 5 అక్షరాలు ఉండాలి!"); return; }

      const currentHash = await hashPassword(current);
      if (currentHash !== getSavedHash()) { alert("పాత పాస్‌వర్డ్ తప్పు!"); return; }

      const newHash = await hashPassword(newPass);
      localStorage.setItem('vidyarthinidhi_admin_hash', newHash);
      alert("పాస్‌వర్డ్ വിജയవంతంగా మార్చబడింది!");
      document.getElementById('currentPassInput').value = '';
      document.getElementById('newPassInput').value = '';
      togglePasswordChangeBox();
    }

    function showForgotScreen() {
      document.getElementById('loginForm').style.display = 'none';
      document.getElementById('forgotForm').style.display = 'block';
    }

    function showLoginScreen() {
      document.getElementById('forgotForm').style.display = 'none';
      document.getElementById('loginForm').style.display = 'block';
    }

    async function submitForgotReset() {
      const pin = document.getElementById('recoveryPinInput').value;
      const newPass = document.getElementById('forgotNewPass').value;

      if (pin !== RECOVERY_PIN) { alert("రికవరీ పిన్ తప్పు!"); return; }
      if (!newPass || newPass.length < 5) { alert("కనీసం 5 అక్షరాలు ఉండాలి."); return; }

      const newHash = await hashPassword(newPass);
      localStorage.setItem('vidyarthinidhi_admin_hash', newHash);
      alert("పాస్‌వర్డ్ విజయవంతంగా రీసెట్ చేయబడింది!");
      document.getElementById('recoveryPinInput').value = '';
      document.getElementById('forgotNewPass').value = '';
      showLoginScreen();
    }

    function showSection(id, btnElement) {
      document.querySelectorAll('.section').forEach(sec => sec.classList.remove('active'));
      document.querySelectorAll('nav a').forEach(a => a.classList.remove('active'));
      document.getElementById(id).classList.add('active');
