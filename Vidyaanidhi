    const ottulu = ["క్ - క వత్తు", "గ్ - గ వత్తు", "చ్ - చ వత్తు", "ట్ - ట వత్తు", "త్ - త వత్తు", "ద్ - ద వత్తు", "న్ - న వత్తు", "ప్ - ప వత్తు", "మ్ - మ వత్తు", "య్ - య వత్తు", "ర్ - ర వత్తు", "ల్ - ల వత్తు", "వ్ - వ వత్తు"];

