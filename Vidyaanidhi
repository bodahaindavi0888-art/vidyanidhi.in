    function generateList(baseWords, label) {
      let res = [...baseWords];
      while(res.length < 100) res.push(`${label} ${res.length + 1}`);
      return res;
    }

    const achuluWords = generateList(["అరక", "ఆవు", "ఇల్లు", "ఈగ", "ఉడుత", "ఊయల", "ఋషి", "ఎలుక", "ఏనుగు", "ఐరావతం", "ఒంటె", "ఓడ", "ఔషధం", "అంబరం"], "అచ్చు పదం");
    const halluluWords = generateList(["కలము", "ఖడ్గము", "గంట", "ఘటము", "చదరంగం", "ఛత్రము", "జలజ", "ఝషము", "టపాకాయ", "ఠవళము", "డమరుకం", "ఢంకా", "తబల", "దండ", "నగ", "పడవ", "ఫలము", "బలపం", "భజన", "మంచం", "యజ్ఞం", "రథం", "లత", "వల", "శంఖం", "షట్పది", "సరసం", "హంస"], "హల్లు పదం");
    const saralaList = generateList(["అరక", "ఆలయం", "ఇల", "ఈగ", "ఉడత", "ఊయల", "కలము", "గడప", "చదరంగం", "జలజ", "తబల", "దండ", "నగ", "పడవ", "బలపం", "మంచం", "వల", "శనగ", "సవరం", "హలం", "వనము", "రణం", "కమలం", "గగనం", "భవనం", "నయనం", "పవనం", "సరళం", "తరగతి", "నటన"], "సరళ పదం");
    const dvitvaList = generateList(["అమ్మ", "నాన్న", "అక్క", "చెల్లి", "తమ్ముడు", "కుక్క", "నక్క", "బస్సు", "గువ్వ", "పిట్ట", "మొగ్గ", "పువ్వు", "చెట్టు", "గిన్నె", "కప్ప", "బల్లి", "రొట్టె", "అద్దం", "ముద్ద", "సుద్ద"], "ద్విత్వ పదం");
    const samyuktaList = generateList(["పుస్తకం", "సూర్యుడు", "చంద్రుడు", "మిత్రుడు", "విద్యార్థి", "ధర్మం", "కర్మ", "శాస్త్రం", "తీవ్రత", "వక్త్రం", "రాష్ట్రం", "రత్నం", "స్వప్నం", "శిల్పం", "వస్త్రం", "వ్యక్తి", "శక్తి", "భక్తి", "ముక్తి", "యుక్తి"], "సంయుక్త పదం");

    createWordCards('achulu-container', achulu);
    createWordCards('hallulu-container', hallulu);
    createWordCards('ottulu-container', ottulu);
    createWordCards('achulu-words-container', achuluWords);
    createWordCards('hallulu-words-container', halluluWords);
    createWordCards('sarala-container', saralaList);
    createWordCards('dvitva-container', dvitvaList);
    createWordCards('samyukta-container', samyuktaList);

    // --- ఆన్‌లైన్ క్విజ్ నిర్వహణ డేటా ---
    function getDefaultQuizzes() {
      return [
        { id: 101, sec: 'quiz', cls: '10', type: 'online_quiz', qText: "శతక మధురమ లో కవి ఎవరు?", optA: "మారన", optB: "గడియారం రామకృష్ణ శర్మ", optC: "నర్సయ్య", optD: "మారన", correct: "B", updatedOn: "01/01/2026" },
        { id: 102, sec: 'quiz', cls: 'ramayanam', type: 'online_quiz', qText: "బాలకాండ లోని ముఖ్య ఘట్టం ఏమిటి?", optA: "సీతా స్వయంవరం", optB: "లంకా దహనం", optC: "వనవాసం", optD: "సేతు నిర్మాణం", correct: "A", updatedOn: "01/01/2026" },
        { id: 103, sec: 'quiz', cls: 'grammar_quiz', type: 'online_quiz', qText: "'రాముడు బడికి వెళ్ళాడు' - ఇందులో ఏ కాలం ఉంది?", optA: "భూత కాలం", optB: "వర్తమాన కాలం", optC: "భవిష్యత్ కాలం", optD: "తద్ధర్మ కాలం", correct: "A", updatedOn: "01/01/2026" }
      ];
    }

    function openAdminLogin() { document.getElementById('adminModal').style.display = 'flex'; showLoginScreen(); }
    function closeAdmin() { document.getElementById('adminModal').style.display = 'none'; cancelEdit(); }

    function logoutAdmin() {
      isAdminLoggedIn = false;
      document.getElementById('loginForm').style.display = 'block';
      document.getElementById('uploadForm').style.display = 'none';
      document.getElementById('forgotForm').style.display = 'none';
      document.getElementById('adminPass').value = '';
      toggleAdminControls(false);
      closeAdmin();
    }

    function toggleAdminControls(show) {
      document.querySelectorAll('.admin-controls').forEach(el => {
        el.style.display = show ? 'block' : 'none';
      });
    }

    function toggleUploadInputs() {
      const type = document.getElementById('fileType').value;
      document.getElementById('fileInputGroup').style.display = (type === 'image' || type === 'pdf') ? 'block' : 'none';
    }

    function toggleQuizFormFields() {
      const sec = document.getElementById('uploadSec').value;
      const quizFields = document.getElementById('quizFormFields');
      const stdGroup = document.getElementById('standardTitleGroup');
      const fileTypeGroup = document.getElementById('fileTypeGroup');
      const urlGroup = document.getElementById('urlInputGroup');

      if (sec === 'quiz') {
        // అడ్మిన్ క్విజ్ ప్రశ్నలను కూడా ఎంటర్ చేయవచ్చు లేదా స్టాండర్డ్ ఫైల్ అప్‌లోడ్ చేయవచ్చు
        if(confirm("మీరు ఆన్‌లైన్ క్విజ్ ప్రశ్నను జోడించాలనుకుంటున్నారా? (Cancel నొక్కితే సాధారణ PDF/లింక్ అప్‌లోడ్ చేసుకోవచ్చు)")) {
          quizFields.style.display = 'block';
          stdGroup.style.display = 'none';
          fileTypeGroup.style.display = 'none';
          urlGroup.style.display = 'none';
          document.getElementById('fileType').value = 'online_quiz';
        } else {
          quizFields.style.display = 'none';
          stdGroup.style.display = 'block';
          fileTypeGroup.style.display = 'block';
          urlGroup.style.display = 'block';
          document.getElementById('fileType').value = 'pdf';
        }
      } else {
        quizFields.style.display = 'none';
        stdGroup.style.display = 'block';
        fileTypeGroup.style.display = 'block';
        urlGroup.style.display = 'block';
      }
    }

    // సేవ్ & అప్‌డేట్
    function saveUpload() {
      const editId = document.getElementById('editItemId').value;
      const sec = document.getElementById('uploadSec').value;
      const cls = document.getElementById('uploadClass').value;
      const type = document.getElementById('fileType').value;
      const dateStr = new Date().toLocaleDateString('te-IN');

      let data = JSON.parse(localStorage.getItem('vidyarthinidhi_items') || JSON.stringify(getDefaultQuizzes()));

      if (type === 'online_quiz') {
        const qText = document.getElementById('quizQText').value;
        const optA = document.getElementById('quizOptA').value;
        const optB = document.getElementById('quizOptB').value;
        const optC = document.getElementById('quizOptC').value;
        const optD = document.getElementById('quizOptD').value;
        const correct = document.getElementById('quizCorrectOpt').value;

        if (!qText || !optA || !optB) { alert("దయచేసి ప్రశ్న మరియు ఆప్షన్లు పూరించండి!"); return; }

        if (editId) {
          const idx = data.findIndex(i => i.id == editId);
          if (idx !== -1) {
            data[idx] = { id: Number(editId), sec, cls, type, qText, optA, optB, optC, optD, correct, updatedOn: dateStr };
            alert("క్విజ్ ప్రశ్న విజయవంతంగా నవీకరించబడింది!");
          }
        } else {
          data.push({ id: Date.now(), sec, cls, type, qText, optA, optB, optC, optD, correct, updatedOn: dateStr });
          alert("కొత్త క్విజ్ ప్రశ్న శాశ్వతంగా జోడించబడింది!");
        }

        localStorage.setItem('vidyarthinidhi_items', JSON.stringify(data));
        cancelEdit();
        loadUploadedItems();
        closeAdmin();
        return;
      }

      // స్టాండర్డ్ ఫైల్ అప్‌లోడ్
      const title = document.getElementById('uploadTitle').value;
      let url = document.getElementById('uploadUrl').value;
      if (!title) { alert("శీర్షిక రాయండి!"); return; }

      const fileInput = document.getElementById('fileDirect');
      if (fileInput.files.length > 0 && (type === 'image' || type === 'pdf')) {
        const reader = new FileReader();
        reader.onload = function(e) {
          commitSave(editId, sec, cls, title, type, e.target.result, dateStr, data);
        };
        reader.readAsDataURL(fileInput.files[0]);
      } else {
        commitSave(editId, sec, cls, title, type, url || "#", dateStr, data);
      }
    }

    function commitSave(editId, sec, cls, title, type, link, dateStr, data) {
      if (editId) {
        const index = data.findIndex(i => i.id == editId);
        if (index !== -1) {
          data[index].sec = sec;
          data[index].cls = cls;
          data[index].title = title;
          data[index].type = type;
          if (link !== "#") data[index].link = link;
          data[index].updatedOn = dateStr;
          alert("అంశం విజయవంతంగా నవీకరించబడింది!");
        }
      } else {
        data.push({ id: Date.now(), sec, cls, title, type, link, updatedOn: dateStr });
        alert("కొత్త అంశం శాశ్వతంగా జోడించబడింది!");
      }

      localStorage.setItem('vidyarthinidhi_items', JSON.stringify(data));
      cancelEdit();
      loadUploadedItems();
      closeAdmin();
    }

    function editItem(id) {
      let data = JSON.parse(localStorage.getItem('vidyarthinidhi_items') || JSON.stringify(getDefaultQuizzes()));
      const item = data.find(i => i.id == id);
      if (!item) return;

      openAdminLogin();
      document.getElementById('loginForm').style.display = 'none';
      document.getElementById('uploadForm').style.display = 'block';

      document.getElementById('editItemId').value = item.id;
      document.getElementById('uploadSec').value = item.sec;
      document.getElementById('uploadClass').value = item.cls;

      if (item.type === 'online_quiz') {
        document.getElementById('quizFormFields').style.display = 'block';
        document.getElementById('standardTitleGroup').style.display = 'none';
        document.getElementById('fileTypeGroup').style.display = 'none';
        document.getElementById('urlInputGroup').style.display = 'none';
        document.getElementById('fileType').value = 'online_quiz';

        document.getElementById('quizQText').value = item.qText;
        document.getElementById('quizOptA').value = item.optA;
        document.getElementById('quizOptB').value = item.optB;
        document.getElementById('quizOptC').value = item.optC;
        document.getElementById('quizOptD').value = item.optD;
        document.getElementById('quizCorrectOpt').value = item.correct;
      } else {
        document.getElementById('uploadTitle').value = item.title;
        document.getElementById('fileType').value = item.type;
        document.getElementById('uploadUrl').value = item.link && !item.link.startsWith('data:') ? item.link : '';
      }

      document.getElementById('formHeading').innerHTML = '<i class="fa-solid fa-pen-to-square"></i> వివరాలు అప్‌డేట్ చేయండి';
      document.getElementById('saveSubmitBtn').innerHTML = '<i class="fa-solid fa-arrows-rotate"></i> అప్‌డేట్ చేయండి';
      document.getElementById('cancelEditBtn').style.display = 'inline-block';
    }

    function cancelEdit() {
      document.getElementById('editItemId').value = '';
      document.getElementById('uploadTitle').value = '';
      document.getElementById('uploadUrl').value = '';
      document.getElementById('fileDirect').value = '';
      document.getElementById('quizFormFields').style.display = 'none';
      document.getElementById('standardTitleGroup').style.display = 'block';
      document.getElementById('fileTypeGroup').style.display = 'block';
      document.getElementById('urlInputGroup').style.display = 'block';
      document.getElementById('formHeading').innerHTML = '<i class="fa-solid fa-cloud-arrow-up"></i> అంశం అప్‌లోడ్ / అప్‌డేట్';
      document.getElementById('saveSubmitBtn').innerHTML = '<i class="fa-solid fa-floppy-disk"></i> భద్రపరచు';
      document.getElementById('cancelEditBtn').style.display = 'none';
    }

    function deleteItem(id) {
      if(confirm("ఈ అంశాన్ని తొలగించాలనుకుంటున్నారా?")) {
        let data = JSON.parse(localStorage.getItem('vidyarthinidhi_items') || JSON.stringify(getDefaultQuizzes()));
        data = data.filter(i => i.id != id);
        localStorage.setItem('vidyarthinidhi_items', JSON.stringify(data));
        loadUploadedItems();
      }
    }

    // ఆన్‌లైన్ క్విజ్ ఎవాల్యుయేషన్ (మార్కులు లెక్కించడం)
    function evaluateQuiz(quizId, correctOpt) {
      const selected = document.querySelector(`input[name="quiz_${quizId}"]:checked`);
      const resBox = document.getElementById(`result_${quizId}`);
      resBox.style.display = 'block';

      if (!selected) {
        resBox.style.background = '#ffeaa7';
        resBox.style.color = '#d63031';
        resBox.innerHTML = `⚠️ దయచేసి ఏదైనా ఒక ఆప్షన్ ఎంచుకోండి!`;
        return;
      }

      if (selected.value === correctOpt) {
        resBox.style.background = '#d4edda';
        resBox.style.color = '#155724';
        resBox.innerHTML = `🎉 అభినందనలు! మీ సమాధానం సరైనది (Correct Answer)! (+1 Mark)`;
      } else {
        resBox.style.background = '#f8d7da';
        resBox.style.color = '#721c24';
        resBox.innerHTML = `❌ తప్పు సమాధానం. సరైన సమాధానం: ఆప్షన్ (${correctOpt})`;
      }
    }

    // డేటా లోడింగ్
    function loadUploadedItems() {
      const sections = ['textbooks', 'digital', 'grammar', 'exams', 'quiz', 'projects', 'extra'];
      sections.forEach(s => {
        const grid = document.getElementById(s + '-grid');
        if (grid) grid.innerHTML = '';
      });
      const quizContainer = document.getElementById('quiz-questions-container');
      if(quizContainer) quizContainer.innerHTML = '';

      const data = JSON.parse(localStorage.getItem('vidyarthinidhi_items') || JSON.stringify(getDefaultQuizzes()));

      if(data.length > 0) {
        const latest = data[data.length - 1];
        document.getElementById('recentUpdateTicker').innerText = `తాజా అప్‌డేట్: "${latest.title || latest.qText}" విజయవంతంగా నవీకరించబడింది.`;
      }

      data.forEach(item => {
        if (item.type === 'online_quiz' && item.sec === 'quiz') {
          // ఆన్‌లైన్ క్విజ్ కార్డ్ రెండరింగ్
          if(quizContainer) {
            const qCard = document.createElement('div');
            qCard.className = `quiz-container item-class-${item.cls}`;
            qCard.setAttribute('data-quiz-class', item.cls);
            qCard.innerHTML = `
              <span class="badge"><i class="fa-solid fa-circle-question"></i> తరగతి/విభాగం: ${item.cls}</span>
              ${item.updatedOn ? `<span class="updated-badge"><i class="fa-solid fa-clock-rotate-left"></i> ${item.updatedOn}</span>` : ''}
              <div class="quiz-question">${item.qText}</div>
              <div class="quiz-options">
                <label class="quiz-option-label"><input type="radio" name="quiz_${item.id}" value="A"> A) ${item.optA}</label>
                <label class="quiz-option-label"><input type="radio" name="quiz_${item.id}" value="B"> B) ${item.optB}</label>
                ${item.optC ? `<label class="quiz-option-label"><input type="radio" name="quiz_${item.id}" value="C"> C) ${item.optC}</label>` : ''}
                ${item.optD ? `<label class="quiz-option-label"><input type="radio" name="quiz_${item.id}" value="D"> D) ${item.optD}</label>` : ''}
              </div>
              <button class="btn" style="background:var(--green);" onclick="evaluateQuiz(${item.id}, '${item.correct}')"><i class="fa-solid fa-check-to-slot"></i> సమాధానం తనిఖీ చేయి</button>
              <div id="result_${item.id}" class="quiz-result-box"></div>

              <div class="admin-controls" style="${isAdminLoggedIn ? 'display:block;' : 'display:none;'} margin-top:10px;">
                <button onclick="editItem(${item.id})" class="btn btn-edit"><i class="fa-solid fa-pen"></i> ఎడిట్</button>
                <button onclick="deleteItem(${item.id})" class="btn btn-del"><i class="fa-solid fa-trash"></i> తొలగించు</button>
              </div>
            `;
            quizContainer.appendChild(qCard);
          }
        } else {
          const grid = document.getElementById(item.sec + '-grid');
          if (grid) {
            const card = document.createElement('div');
            card.className = `item-card item-class-${item.cls}`;
            
            let btnIcon = "fa-arrow-up-right-from-square";
            let btnText = "వ్యూ (View)";
            if(item.type === 'youtube') { btnIcon = "fa-brands fa-youtube"; btnText = "చూడండి"; }
            else if(item.type === 'pdf') { btnIcon = "fa-file-pdf"; btnText = "డౌన్‌లోడ్ / వ్యూ"; }
            else if(item.type === 'ppt') { btnIcon = "fa-file-powerpoint"; btnText = "స్లైడ్స్ వ్యూ"; }

            card.innerHTML = `
              <div>
                <span class="badge"><i class="fa-solid fa-tag"></i> ${item.cls}వ తరగతి / విభాగం</span>
                ${item.updatedOn ? `<span class="updated-badge"><i class="fa-solid fa-clock-rotate-left"></i> ${item.updatedOn}</span>` : ''}
              </div>
              <h4>${item.title}</h4>
              <p style="font-size:0.85rem; color:#636e72; margin-bottom:12px;"><i class="fa-solid fa-file"></i> ${item.type.toUpperCase()}</p>
              <a href="${item.link}" target="_blank" class="btn"><i class="fa-solid ${btnIcon}"></i> ${btnText}</a>
              
              <div class="admin-controls" style="${isAdminLoggedIn ? 'display:block;' : 'display:none;'}">
                <button onclick="editItem(${item.id})" class="btn btn-edit"><i class="fa-solid fa-pen"></i> అప్‌డేట్</button>
                <button onclick="deleteItem(${item.id})" class="btn btn-del"><i class="fa-solid fa-trash"></i> తొలగించు</button>
              </div>
            `;
            grid.appendChild(card);
          }
        }
      });
    }

    function filterClass(section, cls, btnElement) {
      const btns = document.querySelectorAll(`#${section} .class-btn`);
      btns.forEach(b => b.classList.remove('active'));
      if(btnElement) btnElement.classList.add('active');

      const cards = document.querySelectorAll(`#${section}-grid .item-card`);
      cards.forEach(card => {
        if (cls === 'all' || card.classList.contains(`item-class-${cls}`)) {
          card.style.display = 'block';
        } else {
          card.style.display = 'none';
        }
      });
    }

    function filterQuiz(cls, btnElement) {
      const btns = document.querySelectorAll(`#quiz .class-btn`);
      btns.forEach(b => b.classList.remove('active'));
      if(btnElement) btnElement.classList.add('active');

      // ఆన్‌లైన్ క్విజ్ ఫిల్టరింగ్
      const qCards = document.querySelectorAll('#quiz-questions-container .quiz-container');
      qCards.forEach(card => {
        const cClass = card.getAttribute('data-quiz-class');
        if (cls === 'all' || cClass === cls) {
          card.style.display = 'block';
        } else {
          card.style.display = 'none';
        }
      });

      // అడ్మిన్ క్విజ్ ఫైల్స్ ఫిల్టరింగ్
      const cards = document.querySelectorAll(`#quiz-grid .item-card`);
      cards.forEach(card => {
        if (cls === 'all' || card.classList.contains(`item-class-${cls}`)) {
          card.style.display = 'block';
        } else {
          card.style.display = 'none';
        }
      });
    }

    function exportDataBackup() {
      const data = localStorage.getItem('vidyarthinidhi_items') || '[]';
      const blob = new Blob([data], { type: "application/json" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `vidyarthinidhi_backup_${Date.now()}.json`;
      a.click();
      URL.revokeObjectURL(url);
      alert("బ్యాకప్ ఫైల్ విజయవంతంగా డౌన్‌లోడ్ అయింది!");
    }

    function importDataBackup(event) {
      const file = event.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = function(e) {
        try {
          const parsed = JSON.parse(e.target.result);
          localStorage.setItem('vidyarthinidhi_items', JSON.stringify(parsed));
          alert("డేటా పునరుద్ధరించబడింది (Restored)!");
          loadUploadedItems();
        } catch (err) {
          alert("సరైన బ్యాకప్ ఫైల్ ఎంచుకోండి.");
        }
      };
      reader.readAsText(file);
    }

    loadUploadedItems();
  </script>
</body>
</html>
