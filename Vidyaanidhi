            <button class="btn" style="background:var(--green); font-size:0.8rem; padding:5px 10px;" onclick="exportDataBackup()"><i class="fa-solid fa-download"></i> బ్యాకప్ డౌన్‌లోడ్</button>
            <button class="btn" style="background:var(--orange); font-size:0.8rem; padding:5px 10px;" onclick="document.getElementById('importFileInput').click()"><i class="fa-solid fa-upload"></i> రీస్టోర్ డేటా</button>
