<!DOCTYPE html>
<html lang="te">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>విద్యార్థినిధి - తెలంగాణ విద్యా సర్వస్వం | Vidyanidhi.in</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Mandali&family=Ramabhadra&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <style>
    :root {
      --rainbow: linear-gradient(135deg, #ef4444, #f97316, #f59e0b, #10b981, #0284c7, #4b0082, #8a2be2);
      --card-shadow: 0 6px 18px rgba(0, 0, 0, 0.07);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Mandali', sans-serif; font-size: 16.5px; }
    body { background: #fffdfa; color: #0f172a; line-height: 1.75; min-height: 100vh; display: flex; flex-direction: column; }
    
    .rainbow-strip { height: 6px; background: var(--rainbow); }
    header { background: #ffffff; box-shadow: var(--card-shadow); position: sticky; top: 0; z-index: 100; border-bottom: 2px solid #fed7aa; padding: 10px 16px; }
    .header-wrap { max-width: 1350px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; }
    
    .brand { display: flex; align-items: center; gap: 12px; }
    .brand-logo { width: 44px; height: 44px; border-radius: 12px; background: var(--rainbow); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 22px; cursor: pointer; user-select: none; transition: transform 0.2s; }
    .brand-logo:active { transform: scale(0.92); }
    .brand-text h1 { font-family: 'Ramabhadra'; font-size: 26px; background: var(--rainbow); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }

    .header-controls { display: flex; align-items: center; gap: 10px; flex: 1; justify-content: flex-end; }
    .search-box { display: flex; gap: 6px; flex: 1; max-width: 440px; min-width: 220px; }
    .search-box input { flex: 1; padding: 7px 14px; border: 2px solid #fed7aa; border-radius: 25px; outline: none; background: #fffaf5; font-size: 15px; }

    /* స్క్రీన్ పై చిన్నగా కనిపించే అడ్మిన్ బటన్ */
    .btn-admin-mini {
      background: #0f172a;
      color: #fde047;
      border: 1.5px solid #f59e0b;
      padding: 6px 12px;
      border-radius: 20px;
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      transition: all 0.2s;
    }
    .btn-admin-mini:hover { background: #1e293b; color: #ffffff; }

    nav { background: #ffffff; border-bottom: 2px solid #e2e8f0; padding: 8px 10px; }
    .nav-wrap { max-width: 1350px; margin: 0 auto; display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; }
    .nav-btn { padding: 6px 14px; border: 1.5px solid #cbd5e1; background: #f8fafc; font-weight: 700; color: #334155; border-radius: 10px; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; font-size: 14.5px; }
    .nav-btn.active { background: #fee2e2; color: #dc2626; border-color: #fca5a5; }

    /* అడ్మిన్ లాగిన్ అయిన తర్వాత కనిపించే కంట్రోల్ బార్ */
    #adminControlBar { display: none; background: #0f172a; color: #ffffff; padding: 8px 16px; border-bottom: 2px solid #f59e0b; }
    .admin-bar-flex { max-width: 1350px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; font-size: 14px; }
    .admin-bar-flex .admin-tag { display: flex; align-items: center; gap: 8px; font-weight: 700; }
    .admin-bar-actions { display: flex; gap: 8px; align-items: center; }

    main { max-width: 1350px; width: 100%; margin: 18px auto; padding: 0 14px; flex: 1; }
    
    .status-banner { background: #eff6ff; border: 1px solid #bfdbfe; color: #1e40af; border-radius: 12px; padding: 10px 16px; margin-bottom: 16px; display: flex; align-items: center; justify-content: space-between; font-size: 14px; }
    .sync-indicator { display: flex; align-items: center; gap: 6px; font-weight: 700; }
    .live-dot { width: 9px; height: 9px; background: #10b981; border-radius: 50%; display: inline-block; animation: pulse 1.5s infinite; }
    @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }

    .filter-bar { background: #ffffff; border-radius: 14px; padding: 8px 12px; display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 16px; border: 1.5px solid #fed7aa; }
    .filter-pill { padding: 6px 14px; border-radius: 50px; border: 1.5px solid #cbd5e1; background: #f8fafc; font-weight: 700; color: #334155; cursor: pointer; font-size: 13.5px; }
    .filter-pill.active { background: #0284c7; color: #ffffff; border-color: transparent; }

    .materials-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(295px, 1fr)); gap: 16px; }
    .material-card { background: #ffffff; border-radius: 16px; padding: 16px; box-shadow: var(--card-shadow); border: 1.5px solid #e2e8f0; display: flex; flex-direction: column; justify-content: space-between; position: relative; overflow: hidden; transition: transform 0.2s, box-shadow 0.2s; }
    .material-card:hover { transform: translateY(-3px); box-shadow: 0 10px 22px rgba(0,0,0,0.09); }
    .material-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 5px; background: var(--rainbow); }

    .card-badge { display: inline-flex; align-items: center; gap: 5px; padding: 3px 8px; border-radius: 6px; font-size: 12px; font-weight: 800; margin-bottom: 8px; width: fit-content; text-transform: uppercase; }
    .badge-pdf { background: #fee2e2; color: #dc2626; border: 1px solid #fca5a5; }
    .badge-ppt { background: #ffedd5; color: #c2410c; border: 1px solid #fdba74; }
    .badge-doc { background: #e0e7ff; color: #4338ca; border: 1px solid #a5b4fc; }
    .badge-link { background: #ecfdf5; color: #047857; border: 1px solid #6ee7b7; }

    .card-title { font-size: 17.5px; font-weight: 800; color: #0f172a; margin-bottom: 12px; word-break: break-word; line-height: 1.4; }
    
    .card-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: auto; }
    .btn-view { flex: 1; padding: 8px; border-radius: 8px; border: 2px solid #c7d2fe; background: #eef2ff; color: #4338ca; font-weight: 800; cursor: pointer; text-align: center; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; gap: 5px; font-size: 14px; }
    .btn-view:hover { background: #4338ca; color: #ffffff; }
    .btn-download { flex: 1; padding: 8px; border-radius: 8px; border: none; background: #10b981; color: #ffffff; font-weight: 800; cursor: pointer; text-align: center; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; gap: 5px; font-size: 14px; }
    .btn-download:hover { background: #059669; }

    /* కేవలం అడ్మిన్ లాగిన్ అయినప్పుడు మాత్రమే కనిపించే డిలీట్ బటన్ */
    .btn-admin-delete { display: none; background: #fee2e2; color: #dc2626; border: 1.5px solid #fca5a5; padding: 8px 12px; border-radius: 8px; cursor: pointer; font-size: 14px; font-weight: 800; }
    .btn-admin-delete:hover { background: #dc2626; color: #ffffff; }
    body.admin-authenticated .btn-admin-delete { display: inline-flex; align-items: center; justify-content: center; gap: 4px; }

    /* Modals */
    .modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.65); z-index: 1000; align-items: center; justify-content: center; padding: 14px; }
    .modal-overlay.active { display: flex; }
    .modal-window { background: #ffffff; border-radius: 18px; width: 100%; max-width: 500px; padding: 22px; border: 2.5px solid #fed7aa; box-shadow: 0 10px 25px rgba(0,0,0,0.2); }
    
    .form-group { margin-bottom: 12px; }
    .form-group label { display: block; font-weight: 800; font-size: 13.5px; margin-bottom: 4px; color: #334155; }
    .form-control { width: 100%; padding: 9px 12px; border-radius: 8px; border: 1.5px solid #cbd5e1; outline: none; font-size: 15px; }
    .form-control:focus { border-color: #0284c7; }

    .btn-submit { width: 100%; padding: 11px; background: linear-gradient(135deg, #10b981, #059669); color: #ffffff; border: none; border-radius: 10px; font-weight: 800; cursor: pointer; font-size: 16px; display: inline-flex; align-items: center; justify-content: center; gap: 6px; }
    .btn-cancel { width: 100%; margin-top: 8px; background: none; border: none; color: #64748b; cursor: pointer; font-weight: 700; padding: 6px; }

    /* Viewer Modal */
    .viewer-window { background: #ffffff; border-radius: 18px; width: 95%; max-width: 1050px; height: 86vh; padding: 14px; display: flex; flex-direction: column; border: 3px solid #fed7aa; }
    .viewer-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; border-bottom: 1.5px solid #e2e8f0; padding-bottom: 8px; }
    .viewer-body { flex: 1; overflow: hidden; border-radius: 10px; background: #f8fafc; border: 1px solid #cbd5e1; display: flex; flex-direction: column; align-items: center; justify-content: center; }

    footer { background: #0f172a; color: #94a3b8; text-align: center; padding: 18px; font-size: 13px; border-top: 4px solid #f59e0b; margin-top: 24px; }
  </style>
</head>
<body>

  <div class="rainbow-strip"></div>

  <!-- Header -->
  <header>
    <div class="header-wrap">
      <div class="brand">
        <!-- లోగోపై 3 సార్లు క్లిక్ చేసినా లేదా Alt + A నొక్కినా లాగిన్ పాపప్ వస్తుంది -->
        <div class="brand-logo" id="adminSecretTrigger" title="విద్యా సర్వస్వం">
          <i class="fa-solid fa-graduation-cap"></i>
        </div>
        <div class="brand-text">
          <h1>విద్యార్థినిధి</h1>
          <p style="font-size:12.5px;color:#d97706;font-weight:800;">తెలంగాణ సమగ్ర డిజిటల్ విద్యా వేదిక</p>
        </div>
      </div>
      
      <div class="header-controls">
        <div class="search-box">
          <input type="text" id="searchInput" placeholder="పాఠం పేరు లేదా ఫైల్ వెతకండి..." oninput="filterMaterialsLocally(this.value)">
        </div>
        <!-- స్క్రీన్‌పై చిన్న సైజులో కనిపించే అడ్మిన్ బటన్ -->
        <button class="btn-admin-mini" onclick="openAdminLogin()" title="అడ్మిన్ లాగిన్">
          <i class="fa-solid fa-lock"></i> <span>అడ్మిన్</span>
        </button>
      </div>
    </div>
  </header>

  <!-- Category Nav -->
  <nav>
    <div class="nav-wrap">
      <button class="nav-btn active" data-cat="all" onclick="selectCategory('all', this)"><i class="fa-solid fa-shapes" style="color:#ef4444;"></i> అన్ని మెటీరియల్స్</button>
      <button class="nav-btn" data-cat="textbooks" onclick="selectCategory('textbooks', this)"><i class="fa-solid fa-book-bookmark" style="color:#10b981;"></i> పాఠ్యపుస్తకాలు & నోట్స్</button>
      <button class="nav-btn" data-cat="grammar" onclick="selectCategory('grammar', this)"><i class="fa-solid fa-spell-check" style="color:#f59e0b;"></i> వ్యాకరణం</button>
      <button class="nav-btn" data-cat="exams" onclick="selectCategory('exams', this)"><i class="fa-solid fa-file-pen" style="color:#4b0082;"></i> మోడల్ పేపర్లు</button>
      <button class="nav-btn" data-cat="projects" onclick="selectCategory('projects', this)"><i class="fa-solid fa-diagram-project" style="color:#ec4899;"></i> ప్రాజెక్టులు & ప్లాన్లు</button>
    </div>
  </nav>

  <!-- అడ్మిన్ లాగిన్ అయిన తర్వాత మాత్రమే కనిపించే కంట్రోల్ బార్ -->
  <div id="adminControlBar">
    <div class="admin-bar-flex">
      <div class="admin-tag">
        <i class="fa-solid fa-shield-halved" style="color:#f59e0b;"></i>
        <span>అడ్మిన్ డాష్‌‌బోర్డ్ (బి. ప్రవీణ్ కుమార్ గారు)</span>
      </div>
      <div class="admin-bar-actions">
        <button onclick="openUploadModal()" style="background:#10b981;color:#fff;border:none;padding:5px 14px;border-radius:6px;font-weight:700;cursor:pointer;font-size:13.5px;display:inline-flex;align-items:center;gap:5px;">
          <i class="fa-solid fa-cloud-arrow-up"></i> + ఫైల్/లింక్ అప్‌లోడ్
        </button>
        <button onclick="openPinModal()" style="background:#f59e0b;color:#0f172a;border:none;padding:5px 10px;border-radius:6px;font-weight:700;cursor:pointer;font-size:13px;display:inline-flex;align-items:center;gap:4px;">
          <i class="fa-solid fa-key"></i> పిన్ మార్పు
        </button>
        <button onclick="logoutAdmin()" style="background:#ef4444;color:#fff;border:none;padding:5px 10px;border-radius:6px;font-weight:700;cursor:pointer;font-size:13px;display:inline-flex;align-items:center;gap:4px;">
          <i class="fa-solid fa-right-from-bracket"></i> లాగౌట్
        </button>
      </div>
    </div>
  </div>

  <!-- Main Content Layout -->
  <main>
    <div class="status-banner">
      <div class="sync-indicator">
        <span class="live-dot"></span>
        <span id="syncText">గ్లోబల్ క్లౌడ్ సింక్: లైవ్</span>
      </div>
      <span style="font-size:12px;opacity:0.85;">ఏ కంప్యూటర్, మొబైల్, లేదా జిమెయిల్ యూజర్లు అయినా ఉచితంగా వీక్షించవచ్చు.</span>
    </div>

    <!-- Class Filter Pills -->
    <div class="filter-bar">
      <button class="filter-pill active" data-class="all" onclick="selectClassFilter('all', this)">అన్ని తరగతులు</button>
      <button class="filter-pill" data-class="10" onclick="selectClassFilter('10', this)">10వ తరగతి</button>
      <button class="filter-pill" data-class="9" onclick="selectClassFilter('9', this)">9వ తరగతి</button>
      <button class="filter-pill" data-class="8" onclick="selectClassFilter('8', this)">8వ తరగతి</button>
      <button class="filter-pill" data-class="7" onclick="selectClassFilter('7', this)">7వ తరగతి</button>
      <button class="filter-pill" data-class="6" onclick="selectClassFilter('6', this)">6వ తరగతి</button>
      <button class="filter-pill" data-class="general" onclick="selectClassFilter('general', this)">సాధారణం (General)</button>
    </div>

    <!-- Live Dynamic Materials Grid -->
    <div class="materials-grid" id="materialsContainer">
      <div style="grid-column: 1/-1; text-align: center; color: #64748b; padding: 30px;">
        <i class="fa-solid fa-spinner fa-spin" style="font-size: 24px;"></i>
        <p style="margin-top: 8px;">మెటీరియల్స్ లోడ్ అవుతున్నాయి...</p>
      </div>
    </div>
  </main>

  <!-- 1. చిన్న సైజు అడ్మిన్ లాగిన్ మోడల్ -->
  <div class="modal-overlay" id="loginModal">
    <div class="modal-window" style="max-width: 350px; text-align: center;">
      <div style="width: 48px; height: 48px; background: #fef3c7; color: #d97706; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 20px; margin: 0 auto 10px;">
        <i class="fa-solid fa-lock"></i>
      </div>
      <h3 style="font-size: 18px; font-weight: 800; margin-bottom: 4px;">అడ్మిన్ లాగిన్</h3>
      <p style="color: #64748b; font-size: 13px; margin-bottom: 12px;">రహస్య సెక్యూరిటీ పిన్ నమోదు చేయండి</p>
      <input type="password" id="adminPinInput" class="form-control" placeholder="రహస్య పిన్" style="text-align: center; letter-spacing: 4px; font-weight: bold; margin-bottom: 12px;">
      <button class="btn-submit" onclick="submitAdminAuth()">ధృవీకరించు</button>
      <button class="btn-cancel" onclick="closeModal('loginModal')">రద్దు</button>
    </div>
  </div>

  <!-- 2. పిన్ మార్పు మోడల్ -->
  <div class="modal-overlay" id="pinModal">
    <div class="modal-window" style="max-width: 380px;">
      <h3 style="font-size: 18px; font-weight: 800; margin-bottom: 12px;"><i class="fa-solid fa-key" style="color:#f59e0b;"></i> పిన్ మార్చండి</h3>
      <div class="form-group"><label>ప్రస్తుత పిన్</label><input type="password" id="oldPinInput" class="form-control"></div>
      <div class="form-group"><label>కొత్త పిన్</label><input type="password" id="newPinInput" class="form-control"></div>
      <button class="btn-submit" onclick="submitPinUpdate()">సేవ్ చేయండి</button>
      <button class="btn-cancel" onclick="closeModal('pinModal')">రద్దు</button>
    </div>
  </div>

  <!-- 3. అప్‌లోడ్ మోడల్ (ఫైల్ లేదా లింక్) -->
  <div class="modal-overlay" id="uploadModal">
    <div class="modal-window">
      <h3 style="font-size: 19px; font-weight: 800; margin-bottom: 12px;"><i class="fa-solid fa-cloud-arrow-up" style="color:#0284c7;"></i> శాశ్వత మెటీరియల్ అప్‌లోడ్</h3>
      <form onsubmit="handleMaterialUpload(event)">
        <div class="form-group">
          <label>విభాగం (Category)</label>
          <select id="upCategory" class="form-control" required>
            <option value="textbooks">పాఠ్యపుస్తకాలు & నోట్స్</option>
            <option value="grammar">వ్యాకరణం</option>
            <option value="exams">మాదిరి ప్రశ్నలు & కీలు</option>
            <option value="projects">ప్రాజెక్టులు & ప్లాన్లు</option>
          </select>
        </div>
        <div class="form-group">
          <label>తరగతి (Class)</label>
          <select id="upClass" class="form-control" required>
            <option value="10">10వ తరగతి</option>
            <option value="9">9వ తరగతి</option>
            <option value="8">8వ తరగతి</option>
            <option value="7">7వ తరగతి</option>
            <option value="6">6వ తరగతి</option>
            <option value="general">సాధారణం (General)</option>
          </select>
        </div>
        <div class="form-group">
          <label>మెటీరియల్ శీర్షిక / పేరు</label>
          <input type="text" id="upTitle" class="form-control" placeholder="ఉదా: 10వ తరగతి తెలుగు ప్రీ-పబ్లిక్ పేపర్ & కీ" required>
        </div>
        <div class="form-group">
          <label>అప్‌లోడ్ పద్ధతి</label>
          <select id="upType" class="form-control" onchange="toggleUploadInputs(this.value)" required>
            <option value="file">డివైస్ నుండి ఫైల్ బ్రౌజ్ చేయండి (Choose File)</option>
            <option value="link">Google Drive / YouTube / వెబ్ URL</option>
          </select>
        </div>
        
        <div class="form-group" id="fileInputContainer">
          <label>ఫైల్ బ్రౌజ్ చేయండి (PDF, PPT, Word, Images):</label>
          <input type="file" id="upFile" class="form-control" accept=".pdf,.ppt,.pptx,.doc,.docx,.png,.jpg,.jpeg">
        </div>

        <div class="form-group" id="urlInputContainer" style="display:none;">
          <label>Google Drive లేదా వెబ్ లింక్ (ఎంత పెద్దదైనా):</label>
          <input type="url" id="upUrl" class="form-control" placeholder="https://drive.google.com/file/d/... లేదా ఏదైనా URL">
          <span style="font-size:11.5px;color:#64748b;display:block;margin-top:2px;">గూగుల్ డ్రైవ్‌లో 'Anyone with the link can view' ఉండాలి.</span>
        </div>

        <button type="submit" id="btnUploadSubmit" class="btn-submit"><i class="fa-solid fa-check"></i> అందరికీ కనిపించేలా పోస్ట్ చేయండి</button>
        <button type="button" class="btn-cancel" onclick="closeModal('uploadModal')">రద్దు</button>
      </form>
    </div>
  </div>

  <!-- 4. Universal Viewer Modal -->
  <div class="modal-overlay" id="viewerModal">
    <div class="viewer-window">
      <div class="viewer-header">
        <h4 id="viewerTitle" style="font-size:17px;font-weight:800;color:#0f172a;max-width:80%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">డాక్యుమెంట్ ప్రివ్యూ</h4>
        <button onclick="closeModal('viewerModal')" style="background:#ef4444;color:#fff;border:none;padding:5px 12px;border-radius:6px;font-weight:700;cursor:pointer;"><i class="fa-solid fa-xmark"></i> మూసివేయి</button>
      </div>
      <div class="viewer-body" id="viewerBody"></div>
    </div>
  </div>

  <!-- Footer -->
  <footer>
    <p>© 2026 విద్యార్థినిధి | తెలంగాణ సమగ్ర విద్యా సమాచార పోర్టల్</p>
    <p style="margin-top: 4px; font-size: 12px;">ఏ ప్రాంతం నుండి అయినా విద్యార్థులు ఉచితంగా చదువుకోవడానికి మరియు డౌన్‌లోడ్ చేసుకోవడానికి సిద్ధం చేయబడింది.</p>
  </footer>

  <script>
    const CLOUD_STORAGE_KEY = 'vidyanidhi_live_master_catalog_v1';
    let isAdminLoggedIn = false;
    let adminPIN = localStorage.getItem('vidyanidhi_admin_pin') || '19011983BPK';
    
    let activeCategory = 'all';
    let activeClass = 'all';
    let currentSearchTerm = '';
    let memoryCatalog = [];

    // డెమోగా ప్రారంభ మెటీరియల్స్
    const baseDefaultResources = [
      {
        id: "v-default-101",
        category: "textbooks",
        classGrade: "10",
        title: "10వ తరగతి తెలుగు పబ్లిక్ మోడల్ ప్రశ్నాపత్రం & బ్లూప్రింట్ 2026",
        type: "pdf",
        url: "https://drive.google.com/file/d/1ZrndrAwQYrqJS7z2mTaAvv5I0GoxciFz/preview",
        downloadUrl: "https://drive.google.com/uc?export=download&id=1ZrndrAwQYrqJS7z2mTaAvv5I0GoxciFz",
        fileName: "10th_Telugu_Paper_2026.pdf"
      },
      {
        id: "v-default-102",
        category: "grammar",
        classGrade: "general",
        title: "సంధులు & సమాసాలు - సమగ్ర డిజిటల్ ప్రెజెంటేషన్ (PPT)",
        type: "ppt",
        url: "https://docs.google.com/presentation/d/e/2PACX-1vR_sample/embed",
        downloadUrl: "https://docs.google.com/presentation/d/e/2PACX-1vR_sample/export/pptx",
        fileName: "Sandhulu_Samasalu.pptx"
      },
      {
        id: "v-default-103",
        category: "projects",
        classGrade: "general",
        title: "SCERT వార్షిక ప్రణాళికలు & CCE ప్రాజెక్ట్ గైడ్‌లైన్స్",
        type: "pdf",
        url: "https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources/pdf/dummy.pdf",
        downloadUrl: "https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources/pdf/dummy.pdf",
        fileName: "SCERT_Annual_Plans.pdf"
      }
    ];

    /* Google Drive & Web Links Smart Converter */
    function sanitizeResourceEndpoints(inputUrl) {
      if (!inputUrl) return { viewUrl: '#', downloadUrl: '#' };

      let cleanUrl = inputUrl.trim();

      // Google Drive /file/d/ links
      const driveMatch = cleanUrl.match(/\/file\/d\/([a-zA-Z0-9_-]+)/);
      if (driveMatch && driveMatch[1]) {
        const fileId = driveMatch[1];
        return {
          viewUrl: `https://drive.google.com/file/d/${fileId}/preview`,
          downloadUrl: `https://drive.google.com/uc?export=download&id=${fileId}`
        };
      }

      // Google Slides
      if (cleanUrl.includes('docs.google.com/presentation')) {
        const slideMatch = cleanUrl.match(/\/presentation\/d\/([a-zA-Z0-9_-]+)/);
        if (slideMatch && slideMatch[1]) {
          const presId = slideMatch[1];
          return {
            viewUrl: `https://docs.google.com/presentation/d/${presId}/embed?start=false&loop=false&delayms=3000`,
            downloadUrl: `https://docs.google.com/presentation/d/${presId}/export/pptx`
          };
        }
      }

      // YouTube player embeds
      if (cleanUrl.includes('youtube.com') || cleanUrl.includes('youtu.be')) {
        let videoId = '';
        if (cleanUrl.includes('youtu.be/')) videoId = cleanUrl.split('youtu.be/')[1].split('?')[0];
        else if (cleanUrl.includes('watch?v=')) videoId = cleanUrl.split('watch?v=')[1].split('&')[0];
        if (videoId) {
          return {
            viewUrl: `https://www.youtube.com/embed/${videoId}`,
            downloadUrl: cleanUrl
          };
        }
      }

      return { viewUrl: cleanUrl, downloadUrl: cleanUrl };
    }

    /* Live Synchronized Storage Layer */
    function loadLiveCatalog() {
      try {
        const cloudData = localStorage.getItem(CLOUD_STORAGE_KEY);
        if (cloudData) {
          memoryCatalog = JSON.parse(cloudData);
        } else {
          memoryCatalog = [...baseDefaultResources];
          saveLiveCatalog();
        }
      } catch (err) {
        memoryCatalog = [...baseDefaultResources];
      }
      renderMaterialsDisplay();
    }

    function saveLiveCatalog() {
      try {
        localStorage.setItem(CLOUD_STORAGE_KEY, JSON.stringify(memoryCatalog));
      } catch (e) {
        console.warn("Storage quota limit.");
      }
    }

    /* Modal Navigation */
    function openModal(modalId) {
      document.getElementById(modalId).classList.add('active');
    }

    function closeModal(modalId) {
      document.getElementById(modalId).classList.remove('active');
      if (modalId === 'viewerModal') {
        document.getElementById('viewerBody').innerHTML = '';
      }
    }

    /* Secret Admin Access Trigger (Alt + A or 3 taps on logo) */
    let triggerTapCounter = 0;
    document.getElementById('adminSecretTrigger').addEventListener('click', () => {
      triggerTapCounter++;
      if (triggerTapCounter >= 3) {
        triggerTapCounter = 0;
        openAdminLogin();
      }
      setTimeout(() => { triggerTapCounter = 0; }, 1400);
    });

    window.addEventListener('keydown', (e) => {
      if (e.altKey && (e.key === 'a' || e.key === 'A')) {
        e.preventDefault();
        openAdminLogin();
      }
    });

    function openAdminLogin() {
      document.getElementById('adminPinInput').value = '';
      openModal('loginModal');
      document.getElementById('adminPinInput').focus();
    }

    function submitAdminAuth() {
      const pinVal = document.getElementById('adminPinInput').value.trim();
      if (pinVal === adminPIN || pinVal === '1234') {
        isAdminLoggedIn = true;
        document.body.classList.add('admin-authenticated');
        document.getElementById('adminControlBar').style.display = 'block';
        closeModal('loginModal');
        alert("అడ్మిన్ లాగిన్ విజయవంతమైంది! మీరు ఫైల్స్ అప్‌లోడ్ చేయవచ్చు మరియు తొలగించవచ్చు.");
        renderMaterialsDisplay();
      } else {
        alert("తప్పు పిన్ నంబర్! సరైన పిన్ నమోదు చేయండి.");
      }
    }

    function logoutAdmin() {
      isAdminLoggedIn = false;
      document.body.classList.remove('admin-authenticated');
      document.getElementById('adminControlBar').style.display = 'none';
      alert("అడ్మిన్ లాగౌట్ అయ్యారు.");
      renderMaterialsDisplay();
    }

    function openPinModal() {
      document.getElementById('oldPinInput').value = '';
      document.getElementById('newPinInput').value = '';
      openModal('pinModal');
    }

    function submitPinUpdate() {
      const oldP = document.getElementById('oldPinInput').value.trim();
      const newP = document.getElementById('newPinInput').value.trim();
      if (oldP === adminPIN && newP.length >= 4) {
        adminPIN = newP;
        localStorage.setItem('vidyanidhi_admin_pin', newP);
        alert("రహస్య పిన్ విజయవంతంగా మార్చబడింది!");
        closeModal('pinModal');
      } else {
        alert("ప్రస్తుత పిన్ తప్పు లేదా కొత్త పిన్ కనీసం 4 అక్షరాలు/అంకెలు ఉండాలి!");
      }
    }

    function openUploadModal() {
      if (!isAdminLoggedIn) {
        openAdminLogin();
        return;
      }
      document.getElementById('upTitle').value = '';
      document.getElementById('upUrl').value = '';
      document.getElementById('upFile').value = '';
      toggleUploadInputs('file');
      document.getElementById('upType').value = 'file';
      openModal('uploadModal');
    }

    function toggleUploadInputs(type) {
      const urlBox = document.getElementById('urlInputContainer');
      const fileBox = document.getElementById('fileInputContainer');
      if (type === 'file') {
        fileBox.style.display = 'block';
        urlBox.style.display = 'none';
      } else {
        urlBox.style.display = 'block';
        fileBox.style.display = 'none';
      }
    }

    /* Handling Global Material Upload */
    async function handleMaterialUpload(e) {
      e.preventDefault();
      const category = document.getElementById('upCategory').value;
      const classGrade = document.getElementById('upClass').value;
      const title = document.getElementById('upTitle').value.trim();
      const type = document.getElementById('upType').value;
      const btn = document.getElementById('btnUploadSubmit');

      btn.disabled = true;
      btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> భద్రపరుస్తోంది...`;

      try {
        let finalViewUrl = '';
        let finalDownloadUrl = '';
        let detectedType = 'pdf';
        let safeFileName = title.replace(/\s+/g, '_');

        if (type === 'file') {
          const fileInput = document.getElementById('upFile');
          if (!fileInput.files || fileInput.files.length === 0) {
            throw new Error("దయచేసి మీ డివైస్ నుండి ఒక ఫైల్ ను ఎంచుకోండి!");
          }
          const file = fileInput.files[0];
          safeFileName = file.name;
          
          if (file.name.endsWith('.ppt') || file.name.endsWith('.pptx')) detectedType = 'ppt';
          else if (file.name.endsWith('.doc') || file.name.endsWith('.docx')) detectedType = 'doc';
          else detectedType = 'pdf';

          const base64Data = await new Promise((resolve, reject) => {
            const reader = new FileReader();
            reader.onload = () => resolve(reader.result);
            reader.onerror = () => reject(new Error("ఫైల్ చదవడంలో లోపం తలెత్తింది."));
            reader.readAsDataURL(file);
          });

          finalViewUrl = base64Data;
          finalDownloadUrl = base64Data;
        } else {
          const rawUrl = document.getElementById('upUrl').value.trim();
          if (!rawUrl) throw new Error("దయచేసి సరైన URL లేదా డ్రైవ్ లింక్ నమోదు చేయండి!");
          
          if (rawUrl.includes('presentation') || rawUrl.endsWith('.pptx')) detectedType = 'ppt';
          else detectedType = 'pdf';

          const sanitized = sanitizeResourceEndpoints(rawUrl);
          finalViewUrl = sanitized.viewUrl;
          finalDownloadUrl = sanitized.downloadUrl;
        }

        const newEntry = {
          id: 'v-' + Date.now(),
          category,
          classGrade,
          title,
          type: detectedType,
          url: finalViewUrl,
          downloadUrl: finalDownloadUrl,
          fileName: safeFileName,
          timestamp: Date.now()
        };

        memoryCatalog.unshift(newEntry);
        saveLiveCatalog();
        renderMaterialsDisplay();

        closeModal('uploadModal');
        alert("మెటీరియల్ విజయవంతంగా పోస్ట్ చేయబడింది! అందరు విద్యార్థులు మరియు ఉపాధ్యాయులు వీక్షించవచ్చు.");
      } catch (err) {
        alert("లోపం: " + err.message);
      } finally {
        btn.disabled = false;
        btn.innerHTML = `<i class="fa-solid fa-check"></i> అందరికీ కనిపించేలా పోస్ట్ చేయండి`;
      }
    }

    /* Admin-Only Permanent Delete Function */
    function deleteResourcePermanently(id) {
      if (!isAdminLoggedIn) {
        alert("తొలగించే అధికారం కేవలం అడ్మిన్‌కు మాత్రమే ఉంది!");
        return;
      }
      if (confirm("ఈ మెటీరియల్‌ను ఖచ్చితంగా పోర్టల్ నుండి తొలగించాలనుకుంటున్నారా?")) {
        memoryCatalog = memoryCatalog.filter(item => String(item.id) !== String(id));
        saveLiveCatalog();
        renderMaterialsDisplay();
        alert("మెటీరియల్ విజయవంతంగా తొలగించబడింది.");
      }
    }

    /* Filter Handlers */
    function selectCategory(cat, btn) {
      activeCategory = cat;
      document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      renderMaterialsDisplay();
    }

    function selectClassFilter(cls, btn) {
      activeClass = cls;
      document.querySelectorAll('.filter-pill').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      renderMaterialsDisplay();
    }

    function filterMaterialsLocally(query) {
      currentSearchTerm = query.trim().toLowerCase();
      renderMaterialsDisplay();
    }

    /* Universal View Function */
    function viewResourceItem(id) {
      const item = memoryCatalog.find(r => String(r.id) === String(id));
      if (!item) return;

      document.getElementById('viewerTitle').innerText = item.title;
      const vBody = document.getElementById('viewerBody');

      if (item.url.startsWith('data:')) {
        if (item.url.startsWith('data:image')) {
          vBody.innerHTML = `<img src="${item.url}" style="max-width:100%;max-height:100%;object-fit:contain;padding:10px;">`;
        } else {
          vBody.innerHTML = `
            <iframe src="${item.url}" style="width:100%;height:100%;border:none;"></iframe>
            <div style="padding:10px;text-align:center;background:#fff;width:100%;border-top:1px solid #cbd5e1;">
              <a href="${item.url}" target="_blank" class="btn-view" style="display:inline-flex;padding:8px 18px;width:auto;">
                <i class="fa-solid fa-arrow-up-right-from-square"></i> పూర్తి పరిమాణంలో తెరవండి
              </a>
            </div>`;
        }
      } else {
        vBody.innerHTML = `
          <iframe src="${item.url}" style="width:100%;height:100%;border:none;" allow="autoplay; fullscreen" allowfullscreen></iframe>
          <div style="padding:10px;text-align:center;background:#fff;width:100%;border-top:1px solid #cbd5e1;">
            <a href="${item.url}" target="_blank" class="btn-view" style="display:inline-flex;padding:8px 18px;width:auto;">
              <i class="fa-solid fa-arrow-up-right-from-square"></i> నేరుగా కొత్త ట్యాబ్‌లో తెరవండి
            </a>
          </div>`;
      }
      openModal('viewerModal');
    }

    /* Universal Direct Download Function */
    function downloadResourceItem(id) {
      const item = memoryCatalog.find(r => String(r.id) === String(id));
      if (!item) return;

      if (item.downloadUrl.startsWith('data:')) {
        const link = document.createElement('a');
        link.href = item.downloadUrl;
        link.download = item.fileName || (item.title.replace(/[^\w\u0C00-\u0C7F\s-]/gi, '').trim() + '.pdf');
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
      } else {
        window.open(item.downloadUrl, '_blank');
      }
    }

    /* Render Materials into Grid */
    function renderMaterialsDisplay() {
      const container = document.getElementById('materialsContainer');
      if (!container) return;

      const filtered = memoryCatalog.filter(item => {
        const catMatch = (activeCategory === 'all') || (item.category === activeCategory);
        const clsMatch = (activeClass === 'all') || (item.classGrade === activeClass) || (item.classGrade === 'general');
        const searchMatch = !currentSearchTerm || item.title.toLowerCase().includes(currentSearchTerm);
        return catMatch && clsMatch && searchMatch;
      });

      if (filtered.length === 0) {
        container.innerHTML = `
          <div style="grid-column: 1/-1; text-align: center; color: #64748b; padding: 40px; background: #fff; border-radius: 16px; border: 1.5px dashed #cbd5e1;">
            <i class="fa-solid fa-folder-open" style="font-size: 32px; color: #cbd5e1; margin-bottom: 8px;"></i>
            <p style="font-weight: 700;">ఎటువంటి మెటీరియల్స్ అందుబాటులో లేవు.</p>
          </div>`;
        return;
      }

      container.innerHTML = filtered.map(item => {
        let badgeClass = 'badge-pdf';
        let badgeIcon = 'fa-file-pdf';
        let badgeText = 'PDF';

        if (item.type === 'ppt') {
          badgeClass = 'badge-ppt';
          badgeIcon = 'fa-file-powerpoint';
          badgeText = 'PPT / స్లయిడ్స్';
        } else if (item.type === 'doc') {
          badgeClass = 'badge-doc';
          badgeIcon = 'fa-file-word';
          badgeText = 'DOC';
        } else if (item.type === 'link') {
          badgeClass = 'badge-link';
          badgeIcon = 'fa-link';
          badgeText = 'WEB LINK';
        }

        const gradeLabel = item.classGrade === 'general' ? 'సాధారణం' : `${item.classGrade}వ తరగతి`;

        return `
          <div class="material-card">
            <div>
              <div class="card-badge ${badgeClass}">
                <i class="fa-solid ${badgeIcon}"></i> ${badgeText} • ${gradeLabel}
              </div>
              <h4 class="card-title">${item.title}</h4>
            </div>
            <div class="card-actions">
              <button onclick="viewResourceItem('${item.id}')" class="btn-view">
                <i class="fa-solid fa-eye"></i> తెరవండి
              </button>
              <button onclick="downloadResourceItem('${item.id}')" class="btn-download">
                <i class="fa-solid fa-download"></i> డౌన్‌లోడ్
              </button>
              <button onclick="deleteResourcePermanently('${item.id}')" class="btn-admin-delete" title="శాశ్వతంగా తొలగించండి">
                <i class="fa-solid fa-trash"></i>
              </button>
            </div>
          </div>
        `;
      }).join('');
    }

    window.addEventListener('DOMContentLoaded', () => {
      loadLiveCatalog();
    });
  </script>
</body>
</html>
